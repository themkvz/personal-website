# Copy to .env and fill in. Canonical list of required variables.
# VITE_* values are public and inlined into the browser bundle at build time.

# OpenPanel server-side client secret (server only, never VITE_-prefixed)
OP_CLIENT_SECRET=

# HMAC key for the visitor fingerprint, at least 32 chars (server only).
# Generate with: openssl rand -hex 32
FINGERPRINT_SECRET=

# OpenPanel public client id and API URL (build-time and run-time)
VITE_OP_CLIENT_ID=
VITE_OP_API_URL=

# GlitchTip DSN (build-time and run-time); also derives the CSP report endpoint
VITE_GLITCHTIP_DSN=

# GrowthBook SDK connection (optional, set both or neither). Server-only: the
# browser evaluates the payload the root loader serializes and never calls
# GrowthBook. Not a management PAT.
GROWTHBOOK_API_HOST=
GROWTHBOOK_CLIENT_KEY=
