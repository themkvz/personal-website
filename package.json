{
  "name": "themkvz",
  "version": "1.0.0",
  "description": "Personal website",
  "author": "Ihor M.",
  "homepage": "https://themkvz.com",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "build:sourcemaps": "SOURCEMAPS=1 react-router build",
    "dev": "react-router dev",
    "start": "react-router-serve ./build/server/index.js",
    "verify:bundle": "D=${BUNDLE_DIR:-build/client}; test -d \"$D\" || { echo \"verify:bundle: $D not found\" >&2; exit 1; }; grep -rlE 'OP_CLIENT_SECRET|env\\.server' \"$D\" && { echo \"verify:bundle: server env identifiers found in client bundle\" >&2; exit 1; }; test $? -eq 1",
    "typecheck": "react-router typegen && tsc",
    "prepare": "husky",
    "lint": "biome check .",
    "lint:fix": "biome check --fix .",
    "format": "biome format --write .",
    "doctor": "react-doctor ."
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,css,md}": [
      "biome check --fix --no-errors-on-unmatched"
    ]
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@icons-pack/react-simple-icons": "^13.15.1",
    "@mdx-js/rollup": "^3.1.1",
    "@openpanel/sdk": "^1.3.1",
    "@openpanel/web": "^1.4.1",
    "@react-router/fs-routes": "8.3.1",
    "@react-router/node": "8.3.1",
    "@react-router/serve": "8.3.1",
    "@sentry/react-router": "^10.73.0",
    "@t3-oss/env-core": "^0.13.11",
    "@uidotdev/usehooks": "^2.4.1",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.2.5",
    "isbot": "^5.2.2",
    "lucide-react": "^1.41.0",
    "motion": "^13.2.0",
    "nuqs": "^2.10.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "8.3.1",
    "remark-frontmatter": "^5.0.0",
    "remark-mdx-frontmatter": "^5.2.0",
    "ts-pattern": "^5.9.0",
    "valibot": "^1.4.2",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@glitchtip/cli": "^1.0.0",
    "@react-router/dev": "8.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.4.1",
    "@types/mdx": "^2.0.14",
    "@types/node": "^24",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.0",
    "react-doctor": "^0.9.13",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  }
}
