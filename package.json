{
  "name": "themkvz",
  "version": "1.0.0",
  "description": "Personal website",
  "author": "Ihor M.",
  "homepage": "https://themkvz.com",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun --bun react-router build",
    "dev": "bun --bun react-router dev",
    "start": "bun --bun react-router-serve ./build/server/index.js",
    "typecheck": "react-router typegen && tsc",
    "db:push": "bunx drizzle-kit push",
    "db:seed": "bun scripts/seed.ts",
    "db:studio": "bunx drizzle-kit studio",
    "prepare": "husky",
    "lint": "biome check .",
    "lint:fix": "biome check --fix .",
    "format": "biome format --write .",
    "doctor": "react-doctor ."
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,css,md}": [
      "biome check --fix --no-errors-on-unmatched"
    ]
  },
  "dependencies": {
    "@base-ui/react": "^1.2.0",
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@hookform/resolvers": "^5.2.2",
    "@icons-pack/react-simple-icons": "^13.11.2",
    "@openpanel/sdk": "^1.0.4",
    "@openpanel/web": "^1.0.7",
    "@react-email/components": "^1.0.8",
    "@react-router/fs-routes": "^7.13.0",
    "@react-router/node": "7.12.0",
    "@react-router/serve": "7.12.0",
    "@t3-oss/env-core": "^0.13.10",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.1",
    "isbot": "^5.1.31",
    "lucide-react": "^0.563.0",
    "motion": "^12.23.12",
    "nodemailer": "^8.0.1",
    "nuqs": "^2.8.8",
    "radix-ui": "^1.4.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-hook-form": "^7.71.1",
    "react-router": "7.12.0",
    "remix-hook-form": "^7.1.1",
    "tailwind-merge": "^3.4.0",
    "three": "^0.183.1",
    "zod": "^4.3.6",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.15",
    "@react-router/dev": "7.12.0",
    "@tailwindcss/vite": "^4.1.13",
    "@types/bun": "^1.3.9",
    "@types/node": "^22",
    "@types/nodemailer": "^7.0.11",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.183.1",
    "drizzle-kit": "^0.31.9",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "react-doctor": "^0.0.18",
    "shadcn": "^3.8.4",
    "tailwindcss": "^4.1.13",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.7",
    "vite-tsconfig-paths": "^5.1.4"
  }
}
